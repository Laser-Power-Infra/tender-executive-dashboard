model SopDailyLog {
  id                  Int               @id @default(autoincrement())
  sopResponsibilityId Int
  sopResponsibility   SopResponsibility @relation(fields: [sopResponsibilityId], references: [id], onDelete: Cascade)
  date                DateTime          @db.Date // IST day 00:00
  isChecked           Boolean           @default(false)
  checkedBy           String? // session.user.email
  checkedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([sopResponsibilityId, date])
  @@index([date])
  @@index([sopResponsibilityId])
  @@map("sop_daily_logs")
}


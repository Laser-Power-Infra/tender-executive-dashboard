model ColumnMapping {
  id          Int      @id @default(autoincrement())
  excelHeader String
  dbField     String
  displayName String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([excelHeader, dbField])
  @@index([dbField])
  @@map("column_mappings")
}

model ColumnGroup {
  id        Int      @id @default(autoincrement())
  label     String
  separator String   @default(" @ ")
  fields    String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("column_groups")
}

// ---------- COLUMN INDEX ----------
model ColumnIndex {
  id           Int      @id @default(autoincrement())
  columnName   String
  displayOrder Int
  displayName  String?
  visible      Boolean  @default(true)
  width        Int?
  frozen       Boolean  @default(false)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([columnName])
  @@map("column_indices")
}

model ExlusionKeywords {
  id Int @id @default(autoincrement())

  category String  @unique
  keywords String? @default("cable")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- ASSOCIATION ----------
model Association {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenderAssociations TenderAssociation[]

  @@map("associations")
}

model TenderAssociation {
  id Int @id @default(autoincrement())

  // gemTenderId Int?
  // gemTender   GemTender? @relation(fields: [gemTenderId], references: [id], onDelete: Cascade)

  // nonGemTenderId Int?
  // nonGemTender   NonGemTender? @relation(fields: [nonGemTenderId], references: [id], onDelete: Cascade)

  tenderMergedId Int?
  tenderMerged   TenderMerged? @relation(fields: [tenderMergedId], references: [id], onDelete: Cascade)

  associationId Int
  association   Association @relation(fields: [associationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@unique([gemTenderId, associationId])
  // @@unique([nonGemTenderId, associationId])
  @@unique([tenderMergedId, associationId])
  // @@index([gemTenderId])
  // @@index([nonGemTenderId])
  @@index([tenderMergedId])
  @@index([associationId])
  @@map("tender_associations")
}

// ---------- REPORTING ----------
model Reporting {
  id Int @id @default(autoincrement())
  // gemTenderId Int?
  // gemTender   GemTender? @relation(fields: [gemTenderId], references: [id], onDelete: Cascade)

  tenderMergedId Int?
  tenderMerged   TenderMerged? @relation(fields: [tenderMergedId], references: [id], onDelete: Cascade)

  officer  String
  address  String?
  quantity String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@index([gemTenderId])
  @@index([tenderMergedId])
  @@map("reportings")
}

// ---------- TENDER STATUS TABLE ----------
model TenderStatusTable {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  state           String?
  website         String?
  type            String   @default("GEM")
  userId          String?
  password        String?
  mobileNo        String?
  profilePassword String?
  dscName         String?
  dscPassword     String?

  // gemTenders       GemTender[]    @relation("GemTenderStatus")
  // nonGemTenders    NonGemTender[] @relation("NonGemTenderStatus")
  tenderMergedList TenderMerged[]

  @@map("tender_status_table")
}

// ---------- EVALUATION ----------
model Evaluation {
  id Int @id @default(autoincrement())
  // gemTenderId Int?
  // gemTender   GemTender? @relation(fields: [gemTenderId], references: [id], onDelete: Cascade)

  tenderMergedId Int?
  tenderMerged   TenderMerged? @relation(fields: [tenderMergedId], references: [id], onDelete: Cascade)

  sellerName  String
  offeredItem String?
  totalPrice  String?
  rank        String?
  status      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@index([gemTenderId])
  @@index([tenderMergedId])
  @@map("evaluations")
}

// ---------- AI FEEDBACK ----------
model AiFeedback {
  id             String   @id @default(uuid())
  tenderId       Int
  tenderType     String
  briefText      String
  originalAi     String
  correctedAi    String
  feedbackReason String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenderId, tenderType])
  @@map("ai_feedback")
}

// ---------- UTILITY MAPPING ----------
model UtilityMapping {
  id           Int      @id @default(autoincrement())
  organization String
  website      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // gemTenders       GemTender[]
  // nonGemTenders    NonGemTender[]
  tenderMergedList TenderMerged[]

  @@map("utility_mappings")
}

model CostingSheetDetails {
  id Int @id @default(autoincrement())

  itemCode            String
  itemSchedule        String?
  proposedErpItemName String?
  proposedErpQuantity String?
  priceOfFullQuantity String?
  cva                 String?
  location            String?
  bomType             String?
  bomCode             String?

  // Item-wise ranking; read instead of tender_merged's when itemWiseRankEnabled is set.
  ourRank                String?
  ourValue               String?
  nameOfRank1            String?
  valueOfRank1           String?
  differenceBetweenRank1 String?
  nameOfRank2            String?
  valueOfRank2           String?
  differenceBetweenRank2 String?

  tenderMergedId Int?
  TenderMerged   TenderMerged? @relation(fields: [tenderMergedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- TENDER FILES ----------
model TenderFile {
  id        Int      @id @default(autoincrement())
  name      String
  extension String
  url       String
  source    String
  tags      String[] @default([])

  // null = never sent for parsing | PENDING | COMPLETED | FAILED (docs/tender-lifecycle.md)
  parseStatus String?
  parseResult Json?
  parseError  String?

  tenderMergedId Int?
  tenderMerged   TenderMerged? @relation(fields: [tenderMergedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenderMergedId])
  @@map("tender_files")
}

model SupplyDoc {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleBillNumber String
  fileName       String
  extension      String
  filePath       String // raw absolute network path, encrypted at response time
  fileSize       Int?
  lastModified   DateTime?

  @@index([saleBillNumber])
  @@map("supply_docs")
}

model Items {
  id           Int      @id @default(autoincrement())
  itemcode     String   @unique
  itemName     String
  itemSchedule String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- TENDER MERGED ----------
model TenderMerged {
  id         Int        @id @default(autoincrement())
  tenderType TenderType
  originalId Int?

  referenceNo       String          @unique
  tenderBrief       String?
  deadline          DateTime?
  location          String?
  organization      String?
  documentFees      String?
  emd               String?         @default("0")
  msmeExemption     String?
  startupExemption  String?
  quantity          String?
  checklist         String?
  t247Id            String?
  scrapedDate       String?
  source            String?
  assignedTo        String?
  markedStatus      String?
  sheetStatus       String?
  ready             String?
  searchKey         String?
  downloadLink      String?
  currency          String?
  excludedCategory  String?
  aiRelevanceValid  Boolean?
  aiRelevanceReason String?
  tenderFileUrl     String?
  docketNo          String?
  attachmentUrl     String?
  remarks           String?
  app               Decision        @default(NOT_DECIDED)
  aps               Decision        @default(NOT_DECIDED)
  apm               Decision        @default(NOT_DECIDED)
  catalogueDone     Decision        @default(NOT_DECIDED)
  state             String?
  statusCategory    StatusCategory?
  website           String?
  locationCount     Int?
  size              String?
  category          String?
  subCategory       String?

  slNo               Int?
  tenderFor          String?
  tenderOpeningDate  DateTime?
  bidValidityDays    Int?
  contractPeriodDays Int?
  participated       Boolean?
  currentStatus      String?   @default("NOT EVALUATED")

  reverseAuctionApplicable       Boolean?
  reverseAuctionDate             DateTime?
  reverseAuctionStartDate        DateTime?
  reverseAuctionEndDate          DateTime?
  reverseAuctionAutomationStatus String?
  expectedRaDate                 String?

  emdPaymentMode       String?
  bgNoUtrNo            String?
  bgDate               String?
  bgExpiryDate         String?
  claimDate            String?
  bgStatus             String?
  emdValidity          DateTime?
  loiPoNoAndDate       String?
  bidValidityExpired   Boolean?
  price                PriceType?
  diffPercentFromL1    Float?
  diffPercentFromL2    Float?
  reason               String?
  reasonForNotAPM      String?
  finalRemarks         String?
  tenderUpdateStatus   TenderUpdateStatus?
  nextAction           NextAction?
  diffL1ManuallyEdited Boolean?
  diffL2ManuallyEdited Boolean?
  cva                  String?
  quotationNo          String?
  rawMaterials         String?

  value                                   String? @default("0")
  bidOpeningDateTime                      String?
  bidOfferValidity                        String?
  ministryStateName                       String?
  departmentName                          String?
  officeName                              String?
  minimumAverageAnnualTurnover            String?
  yearsOfPastExperience                   String?
  oemAverageTurnover                      String?
  contractPeriod                          String?
  financialDocumentPriceBreakupRequired   String?
  similarCategory                         String?
  pastExperienceSimilarServicesRequired   String?
  documentRequiredFromSeller              String?
  pastPerformance                         String?
  bidToRaEnabled                          String?
  raQualificationRule                     String?
  boqTitle                                String?
  boqSummary                              String?
  bidDetails                              String?
  comprehensiveMaintenanceChargesRequired String?
  typeOfBid                               String?
  technicalClarificationTimeAllowed       String?
  inspectionRequired                      String?
  inspectionAgency                        String?
  /// @deprecated Merged into value (migration 20261021150000). Kept for history; do not read or write.
  estimatedBidValue                       String?
  evaluationMethod                        String?
  advisoryBank                            String?
  ePbgPercentage                          String?
  ePbgDurationMonths                      String?
  msePurchasePreference                   String?
  miiPurchasePreference                   String?
  consigneesReportingOfficer              String?
  mediationClause                         String?
  arbitrationClause                       String?
  itemCategory                            String?
  totalQuantity                           String?
  bidStatus                               String?

  differenceBetweenRank1 String?
  nameOfRank1            String?
  valueOfRank1           String?
  differenceBetweenRank2 String?
  nameOfRank2            String?
  valueOfRank2           String?
  evaluationTableData    String?
  parseStatus            String?
  parseError             String?
  resultAutomationStatus String?
  resultAutomationError  String?
  notificationStatus     String?
  beneficiaryBankDetails String?
  issuingBank            String?

  ourRank  String?
  ourValue String?

  // Ranks are kept per costing item instead of on the tender.
  itemWiseRankEnabled Boolean @default(false)

  proposedErpItemName String?
  proposedErpQuantity String?
  erpPartyName        String?
  contractNo          String?
  tmNo                String?
  typetest String?

  competitors String?
  agentReport String?

  // TENDER_LIFECYCLE_STATUS (lib/tender-lifecycle.ts); null = NEW, nothing published yet.
  lifecycleStatus    String?
  lifecycleUpdatedAt DateTime?
  lifecycleError     String?

  applicableIndex String?
  publishedDate   DateTime?

  baseDate             DateTime?
  buyerDetails         String?
  divisionOrDepartment String?

  fileId Int
  file   File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  tenderStatusId Int?
  tenderStatus   TenderStatusTable? @relation(fields: [tenderStatusId], references: [id], onDelete: SetNull)

  utilityMappingId Int?
  utilityMapping   UtilityMapping? @relation(fields: [utilityMappingId], references: [id])

  // extraFields         TenderExtraField[]
  tenderAssociations  TenderAssociation[]
  reportings          Reporting[]
  evaluations         Evaluation[]
  tenderFiles         TenderFile[]
  CostingSheetDetails CostingSheetDetails[]
  emdMergeds          EmdMerged[]           @relation("EmdMergedToTenderMerged")

  /// Set when a user asks to delete this tender. The row is hidden from the UI until a developer
  /// confirms (permanent delete) or rejects (these three go back to null).
  deleteRequestedAt   DateTime?
  /// User.id of the requester; no FK so removing a user never blocks or cascades here.
  deleteRequestedById String?
  deleteReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileId])
  @@index([tenderStatusId])
  @@index([utilityMappingId])
  @@index([lifecycleStatus])
  @@map("tender_merged")
}


model PerformanceCertificate {
  id        String   @id @default(uuid())
  serial    Int      @unique @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificateName String?
  certificateUrl  String?
  partyName       String?
  utilityOrClient String?
  utilityNames    String?
  itemSchedule    String?
  useNotUse       String?

  // AI-extracted from the certificate document.
  issueDate   DateTime?
  signingDate DateTime?

  // Party reference printed on the certificate; also links the matching SupplyHistory rows.
  partyReferenceNo String?

  // Set when this certificate is a duplicate; points at the original.
  duplicateOfId String?
  duplicateOf   PerformanceCertificate?  @relation("CertDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    PerformanceCertificate[] @relation("CertDuplicate")

  // SupplyHistory rows whose partyRefNo matches this certificate's partyReferenceNo.
  supplyHistories SupplyHistory[] @relation("CertSupplyHistory")

  @@index([duplicateOfId])
  @@map("performance_certificates")
}

